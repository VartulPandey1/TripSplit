# ===================================================================
# TripSplit Deployment Environment Variables
# ===================================================================

# 1. MongoDB Database Connection (MongoDB Atlas for Production)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tripsplit?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/tripsplit?retryWrites=true&w=majority

# 2. Authentication Secret (Auth.js / NextAuth v5)
# Generate with: openssl rand -hex 32
AUTH_SECRET=your_32_byte_hex_secret_here
NEXTAUTH_SECRET=your_32_byte_hex_secret_here

# 3. Canonical App URL (Optional on Vercel with trustHost=true, required for custom domains)
NEXTAUTH_URL=https://your-production-domain.com

# 4. Third-Party Integrations
# Unsplash access key for fetching destination cover images
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_unsplash_access_key
